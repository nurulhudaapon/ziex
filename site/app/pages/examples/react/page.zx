pub fn Page(ctx: zx.PageContext) zx.Component {
    visit_count += 1;

    return (
        <fragment @allocator={ctx.arena}>
            <script src="/assets/jsx.js"></script>
            
            // <Counter visit_count={visit_count} name="Nurul" />
        </fragment>
    );
}

