pub fn Page(ctx: zx.PageContext) zx.Component {
    return (
        <main @allocator={ctx.arena} class="example-page">
            <header class="example-header">
                <h1>Template rendering</h1>
                <p>Raw output from conditionals, loops, components, and switch expressions.</p>
            </header>
            <QuickExample />
        </main>
    );
}

const QuickExample = @import("../../overview/overview.zx").QuickExample;
const zx = @import("zx");
