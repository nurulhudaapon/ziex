pub fn Page(ctx: zx.PageContext) zx.Component {
    return (
        <main @allocator={ctx.arena} class="example-page">
            <header class="example-header">
                <h1>Counter</h1>
                <p>A minimal state example with bound updates and derived output.</p>
            </header>
            <Counter @rendering={.client} initial={0} />
        </main>
    );
}

pub const Counter = @import("./client_counter.zx").Counter;

const zx = @import("zx");
