pub fn Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    const source_url = trySourceUrl(ctx);

    return (
        <div @allocator={ctx.arena}>
            <Sidebar allocator={ctx.arena} categories={&catalog.categories} active_path="/examples" children={(
                <fragment>
                    <div class="example-source-bar">
                        <a class="example-source-link" href={source_url} target="_blank" rel="noopener noreferrer">
                            View source on GitHub ↗
                        </a>
                    </div>
                    {children}
                </fragment>
            )} />
            <script src=`/assets/docs.js?v={zx.info.version}` defer="true"></script>
            <style @escaping={.none}>{@embedFile("style.css")}</style>
        </div>
    );
}

fn trySourceUrl(ctx: zx.LayoutContext) []const u8 {
    return ctx.fmt("{s}/tree/main/site/app/pages{s}", .{
        zx.info.repository,
        ctx.request.pathname,
    }) catch zx.info.repository;
}
const Sidebar = @import("../components/sidebar.zx").Sidebar;
const catalog = @import("catalog.zx");
const zx = @import("zx");
