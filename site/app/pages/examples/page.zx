pub fn Page(ctx: zx.PageContext) zx.Component {
    return (
        <fragment @allocator={ctx.arena}>
            <ExamplesHeader />
            <ExamplesDirectory />
        </fragment>
    );
}

fn ExamplesHeader(allocator: zx.Allocator) zx.Component {
    return (
        <section class="section learn-header" @allocator={allocator}>
            <h1>Examples</h1>
            <p class="lead">Explore examples of Ziex features, with live previews and source code.</p>
        </section>
    );
}

fn ExamplesDirectory(allocator: zx.Allocator) zx.Component {
    return (
        <section class="section examples-directory" @allocator={allocator}>
            {for (catalog.categories) |category| (
                <div class="examples-directory-group">
                    <h3>{category.title}</h3>
                    <div class="examples-directory-grid">
                        {for (category.sections) |item| (
                            <a class="example-route-link" href={item.href}>
                                <strong>{item.title}</strong>
                                <div class="example-route-tags">
                                    {for (item.tags) |tag| (
                                        <code>{tag}</code>
                                    )}
                                </div>
                            </a>
                        )}
                    </div>
                </div>
            )}
        </section>
    );
}

const zx = @import("zx");
const catalog = @import("catalog.zx");
