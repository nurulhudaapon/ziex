pub fn Page(ctx: zx.PageContext, app: Context) zx.Component {
    return (
        <main @allocator={ctx.arena}>
            <p>{app.port}</p>
            <QuickExample />
        </main>
    );
}

const Context = @import("../../Context.zig");

const QuickExample = @import("./../examples/overview.zx").QuickExample;
const zx = @import("zx");