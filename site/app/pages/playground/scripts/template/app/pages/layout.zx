pub fn Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    return (
        <html @allocator={ctx.arena} lang="en-US">
            <head>
                <meta charset="UTF-8" />
                <title>Counter</title>
            </head>
            <body>
                <nav>
                    <a href="/">Home</a>{" · "}
                    <a href="/about">About</a>{" · "}
                    <a href="/api">API</a>
                </nav>
                {children}
            </body>
        </html>
    );
}

const zx = @import("zx");
