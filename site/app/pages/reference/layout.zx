            },
            .{
                .title = "Attribute Syntax",
                .href = "/reference#attribute-syntax",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#spread-attributes", .text = "Spread Attributes" },
                    .{ .href = "/reference#shorthand-attributes", .text = "Shorthand" },
                    .{ .href = "/reference#template-attributes", .text = "Template Strings" },
                },
            },
            .{ .title = "Importing", .href = "/reference#importing" },
            .{ .title = "Fragments", .href = "/reference#fragments" },
            .{ .title = "Children Props", .href = "/reference#children-props" },
            .{
                .title = "Syntax",
                .href = "/reference#syntax",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#multiline-strings", .text = "Multiline Strings" },
                    .{ .href = "/reference#comments", .text = "Comments" },
                },
            },
            .{
                .title = "Caching",
                .href = "/reference#caching",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#caching-enabling", .text = "Enabling" },
