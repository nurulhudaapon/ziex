            },
        },
    },
    .{
        .title = "ADVANCED",
        .sections = &[_]SidebarProps.Section{
            .{
                .title = "Builtin Attributes",
                .href = "/reference#builtin-attributes",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#allocator", .text = "@allocator" },
                    .{ .href = "/reference#escaping", .text = "@escaping" },
                    .{ .href = "/reference#rendering", .text = "@rendering" },
                    .{ .href = "/reference#form-actions", .text = "Form Actions" },
