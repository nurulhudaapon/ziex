    //         .{ .title = "Overview", .href = "/reference#overview" },
    //     },
    // },
    .{
        .title = "CORE",
        .sections = &[_]SidebarProps.Section{
            .{
                .title = "Expressions",
                .href = "/reference#expressions",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#expr-strings", .text = "Strings" },
                    .{ .href = "/reference#expr-integers", .text = "Integers" },
                    .{ .href = "/reference#expr-floats", .text = "Floats" },
                    .{ .href = "/reference#expr-booleans", .text = "Booleans" },
                    .{ .href = "/reference#expr-enums", .text = "Enums" },
                    .{ .href = "/reference#expr-optionals", .text = "Optionals" },
                    .{ .href = "/reference#expr-null", .text = "Null" },
                    .{ .href = "/reference#expr-components", .text = "Components" },
                    .{ .href = "/reference#expr-component-arrays", .text = "Component Arrays" },
                },
            },
            .{
                .title = "Control Flow",
                .href = "/reference#control-flow",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#if-statements", .text = "If Statements" },
                    .{ .href = "/reference#switch-statements", .text = "Switch Statements" },
                    .{ .href = "/reference#for-loops", .text = "For Loops" },
                    .{ .href = "/reference#while-loops", .text = "While Loops" },
                    .{ .href = "/reference#optional-capture", .text = "Optional Capture" },
                    .{ .href = "/reference#error-capture", .text = "Error Capture" },
                },
            },
            .{
                .title = "Components",
                .href = "/reference#components",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#component-context", .text = "ComponentContext" },
                    .{ .href = "/reference#component-ctx-props", .text = "ComponentCtx" },
                },
            },
            .{
                .title = "Routing",
                .href = "/reference#routing",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#pages", .text = "Pages" },
                    .{ .href = "/reference#layouts", .text = "Layouts" },
                    .{ .href = "/reference#dynamic-routes", .text = "Dynamic Routes" },
                },
            },
            .{
                .title = "API & WebSockets",
                .href = "/reference#api-and-websockets",
                .items = &[_]SidebarProps.Link{
                    .{ .href = "/reference#api-routes", .text = "API Routes" },
                    .{ .href = "/reference#websockets", .text = "WebSockets" },
                    .{ .href = "/reference#pub-sub", .text = "Pub/Sub" },
