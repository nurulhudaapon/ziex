const toc_links = [_]SidebarProps.Link{
    // .{ .href = "/reference#overview", .text = "Overview" },
    .{ .href = "/reference#expressions", .text = "Expressions" },
    .{ .href = "/reference#control-flow", .text = "Control Flow" },
    .{ .href = "/reference#components", .text = "Components" },
    .{ .href = "/reference#routing", .text = "Routing" },
    .{ .href = "/reference#api-and-websockets", .text = "API & WebSockets" },
    .{ .href = "/reference#builtin-attributes", .text = "Builtin Attributes" },
    .{ .href = "/reference#form-actions", .text = "Form Actions" },
    .{ .href = "/reference#attribute-syntax", .text = "Attribute Syntax" },
    .{ .href = "/reference#importing", .text = "Importing" },
    .{ .href = "/reference#dynamic-routes", .text = "Dynamic Routes" },
    .{ .href = "/reference#fragments", .text = "Fragments" },
    .{ .href = "/reference#children-props", .text = "Children Props" },
    .{ .href = "/reference#syntax", .text = "Syntax" },
    .{ .href = "/reference#caching", .text = "Caching" },
    .{ .href = "/reference#cli", .text = "CLI" },
};

const Sidebar = @import("../components/sidebar.zx").Sidebar;
const SidebarProps = @import("../components/sidebar.zx").SidebarProps;
const cli_docs = @import("cli_docs.zig");

const cli_sidebar_items = blk: {
    var list: [1 + cli_docs.docs.len]SidebarProps.Link = undefined;
    list[0] = .{ .href = "/reference#cli-installation", .text = "Installation" };
    for (cli_docs.docs, 0..) |cmd, i| {
        list[i + 1] = .{
            .href = "/reference#" ++ cmd.id,
            .text = cmd.name,
        };
    }
    const frozen = list;
    break :blk &frozen;
};

const zx = @import("zx");
