{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "mdzx_inline",
  "rules": {
    "inline": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "_inline_element"
        }
      }
    },
    "_inline_element": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "code_span"
        },
        {
          "type": "SYMBOL",
          "name": "bold_italic"
        },
        {
          "type": "SYMBOL",
          "name": "strong_emphasis"
        },
        {
          "type": "SYMBOL",
          "name": "emphasis"
        },
        {
          "type": "SYMBOL",
          "name": "strikethrough"
        },
        {
          "type": "SYMBOL",
          "name": "inline_link"
        },
        {
          "type": "SYMBOL",
          "name": "full_reference_link"
        },
        {
          "type": "SYMBOL",
          "name": "image"
        },
        {
          "type": "SYMBOL",
          "name": "autolink"
        },
        {
          "type": "SYMBOL",
          "name": "backslash_escape"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "whitespace"
        },
        {
          "type": "SYMBOL",
          "name": "soft_line_break"
        }
      ]
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\n`\\*_~\\[\\]!<\\\\]+"
        }
      }
    },
    "whitespace": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    "soft_line_break": {
      "type": "PATTERN",
      "value": "\\n"
    },
    "_text_inline_no_link": {
      "type": "PATTERN",
      "value": "[^\\n\\[\\]\\\\]+"
    },
    "code_span": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "`+"
            },
            "named": true,
            "value": "code_span_delimiter"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[^`\\n]+"
                },
                "named": true,
                "value": "code_span_content"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "`+"
            },
            "named": true,
            "value": "code_span_delimiter"
          }
        ]
      }
    },
    "emphasis": {
      "type": "PREC_DYNAMIC",
      "value": 1,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "*"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[^*\\n]+"
                },
                "named": true,
                "value": "emphasis_content"
              },
              {
                "type": "STRING",
                "value": "*"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "_"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[^_\\n]+"
                },
                "named": true,
                "value": "emphasis_content"
              },
              {
                "type": "STRING",
                "value": "_"
              }
            ]
          }
        ]
      }
    },
    "strong_emphasis": {
      "type": "PREC_DYNAMIC",
      "value": 2,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "**"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[^*\\n]+"
                },
                "named": true,
                "value": "strong_emphasis_content"
              },
              {
                "type": "STRING",
                "value": "**"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "__"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[^_\\n]+"
                },
                "named": true,
                "value": "strong_emphasis_content"
              },
              {
                "type": "STRING",
                "value": "__"
              }
            ]
          }
        ]
      }
    },
    "bold_italic": {
      "type": "PREC_DYNAMIC",
      "value": 5,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "***"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[^*\\n]+"
                },
                "named": true,
                "value": "bold_italic_content"
              },
              {
                "type": "STRING",
                "value": "***"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "___"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[^_\\n]+"
                },
                "named": true,
                "value": "bold_italic_content"
              },
              {
                "type": "STRING",
                "value": "___"
              }
            ]
          }
        ]
      }
    },
    "strikethrough": {
      "type": "PREC_DYNAMIC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "~~"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[^~\\n]+"
            },
            "named": true,
            "value": "strikethrough_content"
          },
          {
            "type": "STRING",
            "value": "~~"
          }
        ]
      }
    },
    "inline_link": {
      "type": "PREC",
      "value": 3,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "link_text"
          },
          {
            "type": "STRING",
            "value": "("
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_whitespace"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "link_destination"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_whitespace"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "link_title"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_whitespace"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "STRING",
            "value": ")"
          }
        ]
      }
    },
    "link_text": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_text_inline_no_link"
                },
                "named": true,
                "value": "link_text_content"
              },
              {
                "type": "SYMBOL",
                "name": "backslash_escape"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "full_reference_link": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "link_text"
          },
          {
            "type": "STRING",
            "value": "["
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "ALIAS",
                "content": {
                  "type": "PATTERN",
                  "value": "[^\\]]+"
                },
                "named": true,
                "value": "link_label"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "STRING",
            "value": "]"
          }
        ]
      }
    },
    "image": {
      "type": "PREC",
      "value": 3,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "!"
          },
          {
            "type": "SYMBOL",
            "name": "link_text"
          },
          {
            "type": "STRING",
            "value": "("
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_whitespace"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "link_destination"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_whitespace"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "link_title"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_whitespace"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "STRING",
            "value": ")"
          }
        ]
      }
    },
    "link_destination": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "<"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "PATTERN",
                "value": "[^<>\\n]+"
              },
              "named": true,
              "value": "uri"
            },
            {
              "type": "STRING",
              "value": ">"
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "[^\\s\\(\\)\\[\\]\"']+"
        }
      ]
    },
    "link_title": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_word"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_whitespace"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "backslash_escape"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_word"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_whitespace"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "backslash_escape"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        }
      ]
    },
    "autolink": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "<"
          },
          {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s<>]*"
            },
            "named": true,
            "value": "uri"
          },
          {
            "type": "STRING",
            "value": ">"
          }
        ]
      }
    },
    "backslash_escape": {
      "type": "SYMBOL",
      "name": "_backslash_escape"
    },
    "_backslash_escape": {
      "type": "PATTERN",
      "value": "\\\\[!-/:-@\\[-`\\{-~]"
    },
    "_word": {
      "type": "PATTERN",
      "value": "[^!-/:-@\\[-`\\{-~ \\t\\n\\r]+"
    },
    "_whitespace": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}