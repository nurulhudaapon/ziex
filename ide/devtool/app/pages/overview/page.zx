pub fn Page(ctx: zx.PageContext) zx.Component {
    const href = if (options.platform == .chromium) "app.html" else "app";
    return (
        <div @allocator={ctx.arena} class="prefs-page">
            <p class="about-redirect">
                Moved to <a href={href}>App</a>.
            </p>
        </div>
    );
}

const options = @import("build_options");
const zx = @import("zx");
