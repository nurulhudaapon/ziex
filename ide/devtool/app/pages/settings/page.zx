const zx = @import("zx");
const data = @import("../data.zig");
const theme = @import("theme.zig");
const ConnectionFallback = @import("../connection_fallback.zx");

pub fn Page(ctx: zx.PageContext) zx.Component {
    return (
        <div @allocator={ctx.arena} class="prefs-page">
            <section class="prefs-group">
                <h3 class="prefs-group-title">Appearance</h3>
                <div class="prefs-list">
                    <ThemeSetting @rendering={.client} />
                </div>
            </section>

            <section class="prefs-group">
                <h3 class="prefs-group-title">Connection</h3>
                <div class="prefs-list">
                    <HostSetting @rendering={.client} />
                </div>
            </section>

            <section class="prefs-group">
                <h3 class="prefs-group-title">Component Tree</h3>
                <div class="prefs-list">
                    <NativeElementsSetting @rendering={.client} />
                </div>
            </section>

            <section class="prefs-group">
                <h3 class="prefs-group-title">About</h3>
                <div class="prefs-list">
                    <a href="https://github.com/nurulhudaapon/zx" target="_blank" class="prefs-row prefs-link">
                        GitHub
                    </a>
                    <a href="https://ziex.dev" target="_blank" class="prefs-row prefs-link">
                        Docs
                    </a>
                    <a href="https://github.com/nurulhudaapon/zx/issues" target="_blank" class="prefs-row prefs-link">
                        Issues
                    </a>
                </div>
            </section>
        </div>
    );
}

pub fn ThemeSetting(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    theme.applyFromStorage();
    const dark = theme.isDark();
    return (
        <div @allocator={ctx.allocator} class="prefs-row">
            <span class="prefs-label">Theme</span>
            <button @allocator={ctx.allocator} onclick={handleThemeToggle} class="prefs-chip">
                {if (dark) "Dark" else "Light"}
            </button>
        </div>
    );
}

pub fn handleThemeToggle(_: zx.client.Event) void {
    _ = theme.toggle();
    zx.client.rerender();
}

pub fn NativeElementsSetting(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    _ = data.loadSettings();
    const label = if (data.show_native_elements) "On" else "Off";
    return (
        <div @allocator={ctx.allocator} class="prefs-row">
            <span class="prefs-label">Show native elements</span>
            <button @allocator={ctx.allocator} onclick={handleNativeElementsToggle} class="prefs-chip">
                {label}
            </button>
        </div>
    );
}

pub fn handleNativeElementsToggle(_: zx.client.Event) void {
    data.show_native_elements = !data.show_native_elements;
    data.saveSettings();
    zx.client.rerender();
}

pub fn HostSetting(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    _ = data.loadSettings();
    return (
        <div @allocator={ctx.allocator} class="prefs-row prefs-row-stack">
            <label class="prefs-label" for="zx-host-input">Host</label>
            <input
                id="zx-host-input"
                class="prefs-input"
                type="text"
                value={data.host}
                oninput={handleHostInput}
                placeholder="localhost:3000"
            />
            <p class="prefs-hint">Tip: <code>?port=3000</code></p>
        </div>
    );
}

pub fn handleHostInput(ctx: zx.client.Event) void {
    if (ctx.value()) |val| {
        data.setHost(val);
        ConnectionFallback.retryFetches(zx.allocator);
        zx.client.rerender();
    }
}
