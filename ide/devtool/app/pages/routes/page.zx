const zx = @import("zx");
const std = @import("std");
const store = @import("store.zig");

pub fn Page(ctx: zx.PageContext) zx.Component {
    return (
        <div @allocator={ctx.arena} class="app-container">
            <div class="content">
                <div class="routes-toolbar">
                    <RouteSearchInput @rendering={.client} />
                </div>
                <RoutesList @rendering={.client} />
            </div>
        </div>
    );
}

pub fn RoutesList(ctx: *zx.ComponentCtx(struct {})) ?zx.Component {
    if (comptime zx.platform.isServer()) return null;

    store.ensureFetched(ctx.allocator);
    return (
        <div @allocator={ctx.allocator} class="routes-list">
            {for (store.routes) |route| (
                <a
                    class={store.getRouteItemClass(route)}
                    href={store.getRouteHref(ctx.allocator, route.path)}
                    data-route-navigate={route.path}
                >
                    <span class="route-path">{route.path}</span>
                    {if (std.mem.eql(u8, route.kind, "Route")) (
                        <span class="route-methods">
                            {for (route.methods, 0..) |method, i| (
                                <span>
                                    {if (i > 0) (<span class="route-method-sep"> </span>) else ""}
                                    <span class={store.getMethodTokenClass(method)}>{method}</span>
                                </span>
                            )}
                        </span>
                    ) else (
                        <span class="route-kind-quiet">{route.kind}</span>
                    )}
                </a>
            )}
        </div>
    );
}

pub fn RouteSearchInput(ctx: *zx.ComponentCtx(struct {})) zx.Component {
    return (
        <input
            @allocator={ctx.allocator}
            oninput={handleRouteSearchInput}
            type="text"
            placeholder="Filter routes…"
            class="route-filter"
        />
    );
}

pub fn handleRouteSearchInput(ctx: zx.client.Event) void {
    store.setSearch(ctx.value());
    zx.client.rerender();
}
