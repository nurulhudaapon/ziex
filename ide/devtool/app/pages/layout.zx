const zx = @import("zx");
const nav = @import("nav.zig");

pub fn Layout(ctx: zx.LayoutContext, children: zx.Component) zx.Component {
    return (
        <html @allocator={ctx.arena} lang="en-US">
            <head>
                <meta charset="UTF-8" />
                <meta name="color-scheme" content="dark" />
                <title>Ziex DevTools</title>
                <link rel="stylesheet" href="assets/style.css" />
            </head>

            <body>
                <div class="app-shell">
                    <header class="app-tabs">
                        {for (nav.menu) |item| (
                            <a
                                href={nav.buildUrl(ctx.arena, item.href)}
                                class={if (nav.isActive(ctx.request.url, item.active_match)) "app-tab active" else "app-tab"}
                            >
                                {item.label}
                            </a>
                        )}
                    </header>
                    <main class="main-content">
                        {children}
                    </main>
                </div>
                <script src="assets/devtools-ui.js"></script>
            </body>
        </html>
    );
}
