#!/bin/bash
set -euo pipefail

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source .env from project root
if [ -f "$PROJECT_ROOT/.env" ]; then
  # shellcheck disable=SC1091
  source "$PROJECT_ROOT/.env"
else
  echo "Error: .env file not found at $PROJECT_ROOT/.env"
  exit 1
fi

cd "$PROJECT_ROOT"

if [ ! -x "$PROJECT_ROOT/node_modules/.bin/vsce" ]; then
  echo "Error: vsce not found. Run npm install in ide/vscode first."
  exit 1
fi

# Pre-release by default. Set STABLE=1 for a stable marketplace release.
PRE_RELEASE=true
if [ "${STABLE:-}" = "1" ]; then
  PRE_RELEASE=false
fi

# Version bump via vsce builtin (patch|minor|major|none). Default patch.
BUMP="${BUMP:-patch}"

echo "Building extension..."
zig build -Doptimize=ReleaseSafe

if [ -z "${VSCE_PAT:-}" ]; then
  echo "Error: VSCE_PAT is not set in .env file"
  exit 1
fi

echo "Publishing to VS Code Marketplace (pre-release=$PRE_RELEASE bump=$BUMP)..."
# vsce publish [patch|minor|major] --no-git-tag-version bumps without committing.
zig build publish -Doptimize=ReleaseSafe -Dpre-release="$PRE_RELEASE" -Dbump="$BUMP"

if [ -n "${OPEN_VSX_TOKEN:-}" ]; then
  echo "Publishing to Open VSX (pre-release=$PRE_RELEASE)..."
  # Uses package.json version already bumped by vsce (when bump != none).
  if [ "$PRE_RELEASE" = "true" ]; then
    npx --yes ovsx publish --pat "$OPEN_VSX_TOKEN" --pre-release
  else
    npx --yes ovsx publish --pat "$OPEN_VSX_TOKEN"
  fi
else
  echo "Warning: OPEN_VSX_TOKEN is not set; skipping Open VSX publish"
fi
