{
  "name": "ziex",
  "displayName": "Ziex",
  "description": "Ziex - full-stack web framework for Zig",
  "version": "0.1.1259",
  "publisher": "ziex",
  "icon": "images/logo.png",
  "private": true,
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ziex",
    "zig",
    "zx",
    "syntax",
    "highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ziex-dev/ziex"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "activationEvents": [
    "onLanguage:zx",
    "onLanguage:zig",
    "onCommand:zx.pasteInMultilineString",
    "onCommand:zx.copyFromMultilineString"
  ],
  "main": "./out/extension",
  "contributes": {
    "configurationDefaults": {
      "explorer.autoRevealExclude": {
        "**/.zig-cache": true,
        "**/zig-cache": true
      },
      "[zx]": {
        "editor.defaultFormatter": "ziex.ziex"
      }
    },
    "configuration": {
      "type": "object",
      "properties": {
        "zx.format.enableZigExpression": {
          "type": "boolean",
          "default": true,
          "description": "Enable autoformatting of Zig expressions (and HTML inside those expressions) that are embedded inside HTML blocks. Default is true. Use the command 'Ziex: Toggle embedded Zig expression formatting' from the Command Palette to toggle this setting."
        }
      }
    },
    "commands": [
      {
        "command": "zx.toggleZigExpressionFormatting",
        "title": "ZX: Toggle embedded Zig expression formatting"
      },
      {
        "command": "zx.toggleMultilineStringLiteral",
        "title": "ZX: Toggle multiline string literal"
      }
    ],
    "keybindings": [
      {
        "command": "zx.toggleMultilineStringLiteral",
        "key": "alt+m",
        "mac": "alt+m",
        "when": "editorTextFocus && editorLangId =~ /^(zx|zig)$/"
      },
      {
        "command": "zx.multilineSmartBackspace",
        "key": "backspace",
        "when": "editorTextFocus && !editorHasSelection && editorLangId =~ /^(zx|zig)$/"
      },
      {
        "command": "zx.copyFromMultilineString",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorTextFocus && editorHasSelection && editorLangId =~ /^(zx|zig)$/"
      },
      {
        "command": "zx.pasteInMultilineString",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "editorTextFocus && editorLangId =~ /^(zx|zig)$/"
      }
    ],
    "languages": [
      {
        "id": "zx",
        "extensions": [
          ".zx",
          ".mdzx"
        ],
        "aliases": [
          "ZX"
        ],
        "configuration": "./language-configuration.json",
        "icon": "images/icon.svg"
      }
    ],
    "grammars": [
      {
        "language": "zx",
        "scopeName": "source.zx",
        "path": "./syntaxes/zx.tmLanguage.json",
        "embeddedLanguages": {
          "meta.tag.zx": "zx-tags",
          "meta.tag.attributes.zx": "zx",
          "meta.embedded.expression.zx": "zx"
        }
      },
      {
        "scopeName": "source.zx.injection",
        "path": "./syntaxes/zx-injection.tmLanguage.json",
        "injectTo": [
          "source.zig",
          "source.zx"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "echo 'extension already built by zig'",
    "compile": "zig build",
    "watch": "node esbuild.js --watch",
    "pack": "zig build pack",
    "pre-release": "zig build pre-release",
    "publish": "zig build publish"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.125.0"
  }
}
