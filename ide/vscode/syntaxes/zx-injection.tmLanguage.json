{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "zx-injection",
  "scopeName": "source.zx.injection",
  "injectionSelector": "L:(source.zig, source.zx) - string - comment - meta.block.zx",
  "patterns": [
    {
      "comment": "SQL injection for db/database query-taking methods (optionally namespaced, e.g. zx.db.run). The first string literal inside the call is the SQL - no preceding argument (allocator, comptime type) is a string, so matching the first string is safe for prepare/run (1st arg), get/all (2nd arg), and row/rows (3rd arg).",
      "begin": "((?:\\b[a-zA-Z_][a-zA-Z0-9_]*\\.)?(?:db|database)\\.(?:prepare|run|get|all|row|rows))\\s*\\(",
      "beginCaptures": {
        "1": {
          "name": "support.function.zig"
        }
      },
      "end": "\\)",
      "patterns": [
        {
          "comment": "Multiline SQL argument",
          "begin": "(?=\\\\\\\\)",
          "end": "(?=[,)])",
          "patterns": [
            {
              "name": "string.quoted.other.multiline.zig",
              "begin": "(\\\\\\\\)",
              "beginCaptures": {
                "1": {
                  "name": "punctuation.definition.string.begin.zig"
                }
              },
              "end": "$",
              "contentName": "source.sql",
              "patterns": [
                {
                  "include": "source.sql"
                }
              ]
            }
          ]
        },
        {
          "comment": "Inline SQL argument",
          "begin": "(\")",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.string.begin.zig"
            }
          },
          "end": "(\")",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.zig"
            }
          },
          "name": "string.quoted.double.zig",
          "contentName": "source.sql",
          "patterns": [
            {
              "include": "source.sql"
            }
          ]
        },
        {
          "include": "source.zig"
        }
      ]
    },
    {
      "comment": "Only parenthesized ZX blocks \u2014 never bare tags or {expr} in ordinary Zig.",
      "include": "source.zx#zx-block"
    }
  ]
}
