{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "zx",
  "scopeName": "source.zx",
  "fileTypes": [
    "zx"
  ],
  "patterns": [
    {
      "include": "#zig-guards"
    },
    {
      "include": "#zx-block"
    },
    {
      "include": "source.zig"
    }
  ],
  "repository": {
    "zig-guards": {
      "comment": "Match Zig comments and string literals before ZX so a '<' or '{' inside them is never treated as markup.",
      "patterns": [
        {
          "name": "comment.line.documentation.zig",
          "match": "//[!/].*$"
        },
        {
          "name": "comment.line.double-slash.zig",
          "match": "//.*$"
        },
        {
          "name": "string.quoted.double.zig",
          "begin": "\"",
          "end": "\"|(?<!\\\\)(?=$)",
          "patterns": [
            {
              "include": "source.zig#stringcontent"
            },
            {
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.zig",
          "match": "'(\\\\.|[^'\\\\])'"
        },
        {
          "name": "string.quoted.other.multiline.zig",
          "match": "^\\s*\\\\\\\\.*$"
        }
      ]
    },
    "zig-multiline-string": {
      "comment": "Zig multiline string literal lines (\\\\...) - must match before HTML tags",
      "name": "string.quoted.other.multiline.zig",
      "match": "^\\s*\\\\\\\\.*$"
    },
    "zx-block": {
      "comment": "ZX markup only appears as a parenthesized expression: (<tag>...</tag>), (<>...</>), or multiline return (\\n  <tag>...). Bare tags and {expr} never match at Zig top level.",
      "patterns": [
        {
          "name": "meta.block.zx",
          "begin": "(\\()\\s*(?=<)",
          "end": "(\\))",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.block.begin.zx"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.section.block.end.zx"
            }
          },
          "patterns": [
            {
              "include": "#zx-block-body"
            }
          ]
        },
        {
          "name": "meta.block.zx",
          "begin": "(\\()\\s*$",
          "end": "(\\))",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.block.begin.zx"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.section.block.end.zx"
            }
          },
          "patterns": [
            {
              "include": "#zx-block-body"
            }
          ]
        }
      ]
    },
    "zx-block-body": {
      "comment": "Root of a zx_block is only an element, self-closing element, or fragment. Fall back to Zig for ordinary multiline call args like foo(\\n  bar\\n).",
      "patterns": [
        {
          "include": "#zx-fragment"
        },
        {
          "include": "#zx-element"
        },
        {
          "include": "#zig-guards"
        },
        {
          "include": "#zx-block"
        },
        {
          "include": "#balanced-paren"
        },
        {
          "include": "source.zig"
        }
      ]
    },
    "zx-fragment": {
      "name": "meta.tag.fragment.zx",
      "begin": "(<>)",
      "end": "(</>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.zx"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.zx"
        }
      },
      "patterns": [
        {
          "include": "#zx-children"
        }
      ]
    },
    "zx-element": {
      "name": "meta.tag.zx",
      "begin": "(<)([a-zA-Z_][a-zA-Z0-9_.-]*)",
      "end": "(/>)|(</)(\\2)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.zx"
        },
        "2": {
          "name": "entity.name.tag.zx"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.zx"
        },
        "2": {
          "name": "punctuation.definition.tag.begin.zx"
        },
        "3": {
          "name": "entity.name.tag.zx"
        },
        "4": {
          "name": "punctuation.definition.tag.end.zx"
        }
      },
      "patterns": [
        {
          "include": "#zx-attribute"
        },
        {
          "begin": "(>)",
          "end": "(?=</)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.zx"
            }
          },
          "contentName": "meta.tag.children.zx",
          "patterns": [
            {
              "include": "#zx-children"
            }
          ]
        }
      ]
    },
    "zx-children": {
      "comment": "Children inside an element/fragment: nested tags, {zig expr}, or text. Not valid at Zig top level.",
      "patterns": [
        {
          "include": "#zx-fragment"
        },
        {
          "include": "#zx-element"
        },
        {
          "include": "#zx-expression"
        },
        {
          "include": "#zx-text"
        }
      ]
    },
    "zx-text": {
      "name": "text.html.zx",
      "match": "[^<>{}\\n]+"
    },
    "zx-attribute": {
      "patterns": [
        {
          "name": "meta.attribute.builtin.with-value.zx",
          "begin": "\\s+(@[a-zA-Z_][a-zA-Z0-9_]*)\\s*(=)",
          "end": "(?=[\\s/>])|(?<=[\"'`}])",
          "beginCaptures": {
            "1": {
              "name": "support.function.builtin.zig"
            },
            "2": {
              "name": "keyword.operator.assignment.zx"
            }
          },
          "patterns": [
            {
              "name": "string.quoted.double.zx",
              "begin": "\"",
              "end": "\"",
              "patterns": [
                {
                  "include": "source.zig#stringcontent"
                }
              ]
            },
            {
              "name": "string.quoted.single.zx",
              "begin": "'",
              "end": "'",
              "patterns": [
                {
                  "include": "source.zig#stringcontent"
                }
              ]
            },
            {
              "include": "#zx-template-string"
            },
            {
              "include": "#zx-expression"
            }
          ]
        },
        {
          "name": "meta.attribute.with-value.zx",
          "begin": "\\s+([a-zA-Z_:][a-zA-Z0-9_:-]*)\\s*(=)",
          "end": "(?=[\\s/>])|(?<=[\"'`}])",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.zx"
            },
            "2": {
              "name": "keyword.operator.assignment.zx"
            }
          },
          "patterns": [
            {
              "name": "string.quoted.double.zx",
              "begin": "\"",
              "end": "\"",
              "patterns": [
                {
                  "include": "source.zig#stringcontent"
                }
              ]
            },
            {
              "name": "string.quoted.single.zx",
              "begin": "'",
              "end": "'",
              "patterns": [
                {
                  "include": "source.zig#stringcontent"
                }
              ]
            },
            {
              "include": "#zx-template-string"
            },
            {
              "include": "#zx-expression"
            }
          ]
        },
        {
          "name": "meta.attribute.builtin.shorthand.zx",
          "match": "\\s+@\\{(@\"[^\"]+\"|[a-zA-Z_][a-zA-Z0-9_]*)\\}",
          "captures": {
            "1": {
              "name": "support.function.builtin.zig"
            }
          }
        },
        {
          "name": "meta.attribute.shorthand.zx",
          "match": "\\s+\\{(@\"[^\"]+\"|[a-zA-Z_][a-zA-Z0-9_]*)\\}",
          "captures": {
            "1": {
              "name": "variable.other.readwrite.zx"
            }
          }
        },
        {
          "name": "meta.attribute.spread.zx",
          "begin": "\\s+(\\{)(\\.\\.)",
          "end": "(\\})",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.embedded.begin.zx"
            },
            "2": {
              "name": "keyword.operator.spread.zx"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.section.embedded.end.zx"
            }
          },
          "patterns": [
            {
              "include": "#zx-expression-body"
            }
          ]
        },
        {
          "name": "meta.attribute.builtin.zx",
          "match": "\\s+(@[a-zA-Z_][a-zA-Z0-9_]*)(?=[\\s/>])",
          "captures": {
            "1": {
              "name": "support.function.builtin.zig"
            }
          }
        },
        {
          "name": "entity.other.attribute-name.zx",
          "match": "\\s+([a-zA-Z_:][a-zA-Z0-9_:-]*)(?=[\\s/>])",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.zx"
            }
          }
        }
      ]
    },
    "zx-expression": {
      "name": "meta.embedded.expression.zx",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.zx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.zx"
        }
      },
      "patterns": [
        {
          "include": "#zx-expression-body"
        }
      ]
    },
    "zx-expression-body": {
      "comment": "Inside {expr}: Zig code plus nested parenthesized ZX blocks. Do not treat bare <tag> or every { as markup \u2014 nested ZX must be ( <...> ).",
      "patterns": [
        {
          "include": "#zig-multiline-string"
        },
        {
          "include": "#zig-guards"
        },
        {
          "include": "#zx-block"
        },
        {
          "include": "#balanced-paren"
        },
        {
          "include": "#balanced-brace"
        },
        {
          "include": "source.zig"
        }
      ]
    },
    "balanced-paren": {
      "comment": "Consume nested (...) so the zx-block end paren matches correctly inside Zig call args.",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#zig-guards"
        },
        {
          "include": "#zx-block"
        },
        {
          "include": "#balanced-paren"
        },
        {
          "include": "source.zig"
        }
      ]
    },
    "balanced-brace": {
      "comment": "Zig anonymous structs / blocks inside a ZX expression: .{ ... } must not reopen zx-expression.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#zig-multiline-string"
        },
        {
          "include": "#zig-guards"
        },
        {
          "include": "#zx-block"
        },
        {
          "include": "#balanced-paren"
        },
        {
          "include": "#balanced-brace"
        },
        {
          "include": "source.zig"
        }
      ]
    },
    "zx-template-string": {
      "name": "string.quoted.template.zx",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.zx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.zx"
        }
      },
      "patterns": [
        {
          "name": "string.template.content.zx",
          "match": "[^`{]+"
        },
        {
          "include": "#zx-template-substitution"
        }
      ]
    },
    "zx-template-substitution": {
      "name": "meta.embedded.expression.template.zx",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.zx"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.zx"
        }
      },
      "patterns": [
        {
          "include": "#zx-expression-body"
        }
      ]
    }
  }
}
